#include <windows.h>

IDI_ICON1 ICON "omnioffice.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041F04B0"
        BEGIN
            VALUE "CompanyName", "OmniOffice"
            VALUE "FileDescription", "OmniOffice - All-in-One Office"
            VALUE "FileVersion", "1.0.0"
            VALUE "InternalName", "OmniOffice"
            VALUE "OriginalFilename", "OmniOffice.exe"
            VALUE "ProductName", "OmniOffice"
            VALUE "ProductVersion", "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x41F, 1200
    END
END
